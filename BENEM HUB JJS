local function updatePlayerDropdownList()
    for _, child in ipairs(PlayerDropdownList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            count = count + 1
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, 0, 0, 30)
            pBtn.BackgroundTransparency = 1
            pBtn.Text = " " .. plr.Name
            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.TextSize = 11
            pBtn.Font = Enum.Font.GothamMedium
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.ZIndex = 6
            pBtn.Parent = PlayerDropdownList
            pBtn.MouseButton1Click:Connect(function()
                selectedTargetPlayer = plr
                PlayerDropdownLabel.Text = plr.Name
                isDropdownOpen = false
                PlayerDropdownList.Visible = false
                PlayerDropdownList.Size = UDim2.new(1, 0, 0, 0)
                PlayerDropdownArrow.Text = "▼"
            end)
        end
    end
    PlayerDropdownList.CanvasSize = UDim2.new(0, 0, 0, count * 30)
    if isDropdownOpen then
        PlayerDropdownList.Size = UDim2.new(1, 0, 0, math.min(count * 30, 120))
    end
end

PlayerDropdownBtn.MouseButton1Click:Connect(function()
    isDropdownOpen = not isDropdownOpen
    if isDropdownOpen then
        PlayerDropdownArrow.Text = "▲"
        PlayerDropdownList.Visible = true
        updatePlayerDropdownList()
        local count = 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then count = count + 1 end
        end
        PlayerDropdownList.Size = UDim2.new(1, 0, 0, math.min(count * 30, 120))
    else
        PlayerDropdownArrow.Text = "▼"
        PlayerDropdownList.Visible = false
        PlayerDropdownList.Size = UDim2.new(1, 0, 0, 0)
    end
end)

Players.PlayerAdded:Connect(function(plr)
