local specialCoord = Vector3.new(47.44, 67.53, 118.69)
local targetCoords = {
    Vector3.new(355.58, 47.82, -397.92),
    Vector3.new(381.77, 70.55, 371.54),
    Vector3.new(-385.22, 83.24, 404.66),
    Vector3.new(-10.52, 68.37, -400.12)
}

local function getNextNearestCoord(currentPos)
    local bestCoord = targetCoords[1]
    local minDistance = math.huge
    local secondBest = targetCoords[1]
    local secondMinDist = math.huge
    
    for _, coord in ipairs(targetCoords) do
        local dist = (currentPos - coord).Magnitude
        if dist < minDistance then
            secondMinDist = minDistance
            secondBest = bestCoord
            minDistance = dist
            bestCoord = coord
        elseif dist < secondMinDist then
            secondMinDist = dist
            secondBest = coord
        end
    end
    
    if minDistance < 15 and #targetCoords > 1 then
        return secondBest
    end
    return bestCoord
end

local isTeleportingActive = false
local currentTween = nil
local currentDiedConn = nil
local currentRemoveConn = nil
local cameraConnection = nil

local function resetTeleportState(character)
    isTeleportingActive = false
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    if cameraConnection then
        cameraConnection:Disconnect()
        cameraConnection = nil
    end
    if currentDiedConn then
        currentDiedConn:Disconnect()
        currentDiedConn = nil
    end
    if currentRemoveConn then
        currentRemoveConn:Disconnect()
        currentRemoveConn = nil
    end
    
    Camera.CameraType = Enum.CameraType.Custom
    
    if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChildOfClass("Humanoid") then
        character.HumanoidRootPart.Anchored = false
        character:FindFirstChildOfClass("Humanoid").PlatformStand = false
    end
    
    ResetBtn.Text = "Start"
end

ResetBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChildOfClass("Humanoid") then
        ResetBtn.Text = "Lỗi!"
        task.wait(1.5)
        ResetBtn.Text = isTeleportingActive and "Stop" or "Start"
        return
    end

    if isTeleportingActive then
        resetTeleportState(character)
        return
    end

    isTeleportingActive = true
    ResetBtn.Text = "Stop"

    local hrp = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    humanoid.PlatformStand = true
    hrp.Anchored = true
    
    local initialCameraCFrame = Camera.CFrame
    local cameraAngles = Vector2.new(0, 0)
    Camera.CameraType = Enum.CameraType.Scriptable
    
    cameraConnection = RunService.RenderStepped:Connect(function()
        if not isTeleportingActive then return end
        local delta = UserInputService:GetMouseDelta()
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) or UserInputService.TouchEnabled then
            cameraAngles = cameraAngles + Vector2.new(-delta.Y * 0.003, -delta.X * 0.003)
            cameraAngles = Vector2.new(math.clamp(cameraAngles.X, -math.pi/2 + 0.01, math.pi/2 - 0.01), cameraAngles.Y)
        end
        local rotationCFrame = CFrame.Angles(0, cameraAngles.Y, 0) * CFrame.Angles(cameraAngles.X, 0, 0)
        Camera.CFrame = CFrame.new(initialCameraCFrame.Position) * rotationCFrame
    end)
    
    currentDiedConn = humanoid.Died:Connect(function() resetTeleportState(character) end)
    currentRemoveConn = LocalPlayer.CharacterRemoving:Connect(function() resetTeleportState(character) end)
    
    task.spawn(function()
        local speed = 500
        
        local function tweenToCoord(targetPos)
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return false end
            local currentHrp = char.HumanoidRootPart
            
            local upPos = currentHrp.Position + Vector3.new(0, 100, 0)
            currentTween = TweenService:Create(currentHrp, TweenInfo.new(100 / speed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(upPos)})
            currentTween:Play()
            currentTween.Completed:Wait()
            
            if not isTeleportingActive or not hum or hum.Health <= 0 then return false end
            
            local highTargetPos = Vector3.new(targetPos.X, upPos.Y, targetPos.Z)
            currentTween = TweenService:Create(currentHrp, TweenInfo.new((currentHrp.Position - highTargetPos).Magnitude / speed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(highTargetPos)})
            currentTween:Play()
            currentTween.Completed:Wait()
            
            if not isTeleportingActive or not hum or hum.Health <= 0 then return false end
            
            currentTween = TweenService:Create(currentHrp, TweenInfo.new((currentHrp.Position - targetPos).Magnitude / speed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
            currentTween:Play()
            currentTween.Completed:Wait()
            
            return true
        end
        
        ResetBtn.Text = "Đang thử..."
        local success, err = pcall(function()
            return tweenToCoord(specialCoord)
        end)
        
        if not isTeleportingActive then
            resetTeleportState(character)
            return
        end
        
        if success then
            ResetBtn.Text = "Kiểm tra..."
            task.wait(2)
            
            local char = LocalPlayer.Character
            local currentHrp = char and char:FindFirstChild("HumanoidRootPart")
            local isOutside = true
            
            if currentHrp then
                if (currentHrp.Position - specialCoord).Magnitude <= 20 then
                    isOutside = false
                end
            end
            
            if not isOutside then
                ResetBtn.Text = "Thành công!"
                task.wait(1.5)
                resetTeleportState(character)
            else
                ResetBtn.Text = "Bay 4 tọa độ..."
                task.wait(1)
                while isTeleportingActive do
                    local char = LocalPlayer.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChildOfClass("Humanoid") then break end
                    local currentHrp = char.HumanoidRootPart
                    local currentHumanoid = char:FindFirstChildOfClass("Humanoid")
                    if currentHumanoid.Health <= 0 then break end
                    
                    local nextTarget = getNextNearestCoord(currentHrp.Position)
                    if not tweenToCoord(nextTarget) then break end
                    
                    if not isTeleportingActive or currentHumanoid.Health <= 0 then break end
                    ResetBtn.Text = "Điểm tiếp..."
                    task.wait(1)
                    ResetBtn.Text = "Stop"
                end
                resetTeleportState(LocalPlayer.Character)
            end
        else
            ResetBtn.Text = "Bay 4 tọa độ..."
            task.wait(1)
            while isTeleportingActive do
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChildOfClass("Humanoid") then break end
                local currentHrp = char.HumanoidRootPart
                local currentHumanoid = char:FindFirstChildOfClass("Humanoid")
                if currentHumanoid.Health <= 0 then break end
                
                local nextTarget = getNextNearestCoord(currentHrp.Position)
                if not tweenToCoord(nextTarget) then break end
                
                if not isTeleportingActive or currentHumanoid.Health <= 0 then break end
                ResetBtn.Text = "Điểm tiếp..."
                task.wait(1)
                ResetBtn.Text = "Stop"
            end
            resetTeleportState(LocalPlayer.Character)
        end
    end)
end)

