RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    for player, drawings in pairs(espCache) do
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if character and humanoid and humanoid.Health > 0 and drawings.Box then
            pcall(function()
                local cf, size = character:GetBoundingBox()
                local topWorld = (cf * CFrame.new(0, size.Y / 2, 0)).Position
                local bottomWorld = (cf * CFrame.new(0, -size.Y / 2, 0)).Position
                local topPos, topVisible = Camera:WorldToViewportPoint(topWorld)
                local bottomPos, bottomVisible = Camera:WorldToViewportPoint(bottomWorld)
                if topPos.Z > 0 then
                    local height = math.abs(topPos.Y - bottomPos.Y)
                    local width = height * 0.5
                    drawings.Box.Size = Vector2.new(width, height)
                    drawings.Box.Position = Vector2.new(topPos.X - width / 2, topPos.Y)
                    drawings.Box.Visible = true

                    drawings.Name.Text = player.Name
                    drawings.Name.Position = Vector2.new(topPos.X, topPos.Y - 18)
                    drawings.Name.Visible = true

                    local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                    local barHeight = height * healthPercent
                    drawings.HealthBG.Size = Vector2.new(3, height)
                    drawings.HealthBG.Position = Vector2.new(topPos.X - width / 2 - 6, topPos.Y)
                    drawings.HealthBG.Visible = true

                    drawings.HealthBar.Size = Vector2.new(3, barHeight)
                    drawings.HealthBar.Position = Vector2.new(topPos.X - width / 2 - 6, topPos.Y + (height - barHeight))
                    drawings.HealthBar.Color = Color3.fromHSV(healthPercent * 0.3, 1, 1)
                    drawings.HealthBar.Visible = true
                else
                    for _, drawing in pairs(drawings) do pcall(function() drawing.Visible = false end) end
                end
            end)
        else
            if drawings.Box then
                for _, drawing in pairs(drawings) do pcall(function() drawing.Visible = false end) end
            end
        end
    end
end)

