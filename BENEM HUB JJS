        TweenService:Create(MainFrame, tweenInfo, {Size = minimizedSize, Position = savedMinimizedPos}):Play()
        TweenService:Create(MinBtn, tweenInfo, {Position = minBtnMiniPos}):Play()
    else
        savedMinimizedPos = MainFrame.Position
        MinBtn.Text = "-"
        ProfileImg.Visible = true
        NameLabel.Visible = true
        MiniTitle.Visible = false
        MiniIcon.Visible = false
        CloseBtn.Visible = true
        Sidebar.Visible = true
        ContentContainer.Visible = true
        TweenService:Create(MainFrame, tweenInfo, {Size = normalSize, Position = centerPosition}):Play()
        TweenService:Create(MinBtn, tweenInfo, {Position = minBtnNormalPos}):Play()
    end
end)

